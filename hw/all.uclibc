ARCH_HAS_MMU=y
ARCH_USE_MMU=y
UCLIBC_HAS_FLOATS=y
HAVE_SHARED=y
UCLIBC_STATIC_LDCONFIG=n
UCLIBC_HAS_THREADS_NATIVE=y
UCLIBC_STRICT_HEADERS=y
DOSTRIP=y
WARNINGS=""
UCLIBC_BUILD_NOEXECSTACK=y

UCLIBC_HAS_NETWORK_SUPPORT=y
UCLIBC_HAS_SOCKET=y
UCLIBC_HAS_IPV4=y
UCLIBC_HAS_IPV6=n

UCLIBC_HAS_GNU_GETOPT=y
