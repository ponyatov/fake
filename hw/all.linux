# General setup
CONFIG_PREEMPT=y
CONFIG_HZ_1000=y

CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_LZMA=n
CONFIG_RD_XZ=n
CONFIG_RD_LZO=n
CONFIG_RD_LZ4=n
CONFIG_RD_ZSTD=n

CONFIG_EMBEDDED=y

# Processor
CONFIG_SMP=y
CONFIG_NR_CPUS=2
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_PARAVIRT_SPINLOCKS=y
CONFIG_KVM_GUEST=y

# Modules
CONFIG_MODULES=y
CONFIG_MODULE_COMPRESS_XZ=y
CONFIG_MODULE_DECOMPRESS=y

# Block
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_BLK_WBT=y
CONFIG_BLK_WBT_MQ=y
CONFIG_BLK_DEV_LOOP=m
CONFIG_BLK_DEV_LOOP_MIN_COUNT=0

CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
CONFIG_MAC_PARTITION=y
CONFIG_EFI_PARTITION=y

# Exec files
CONFIG_BINFMT_ELF=y
CONFIG_COREDUMP=n
CONFIG_BINFMT_SCRIPT=y
CONFIG_BINFMT_MISC=n

# Memory
CONFIG_HIGHMEM4G=y
CONFIG_SWAP=y

# Network
CONFIG_NET=y
CONFIG_PACKET=m
CONFIG_UNIX=m
CONFIG_INET=y
CONFIG_IPV6=n

# Wireless
CONFIG_BT=m
CONFIG_WIRELESS=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RFKILL=m

# Bus
CONFIG_PCI=y

# Drivers
## Generic drivers
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# CONFIG_DEVTMPFS_SAFE=y

## Firmware
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_UPLOAD=y
CONFIG_ALLOW_DEV_COREDUMP=n

## ATA
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_SFF=y
CONFIG_ATA_BMDMA=y
CONFIG_ATA_PII=y

## Video
CONFIG_SYSFB_SIMPLEFB=y
