module pp

imports
  libstratego-lib

imports

  libstratego-gpp
  libspoofax/sdf/pp
  libspoofax/editor/refactoring/-
  pp/F-parenthesize
  pp/F-pp

rules

  editor-format:
    (node, _, ast, path, project-path) -> (filename, result)
    with
      ext      := <get-extension> path
    ; filename := <guarantee-extension(|$[pp.[ext]])> path
    ; result   := <pp-debug> node

rules
  
  pp-F-string =
    parenthesize-F
    ; prettyprint-F-start-symbols
    ; !V([], <id>)
    ; box2text-string(|120)
      
  pp-partial-F-string =
    parenthesize-F
    ; prettyprint-F
    ; !V([], <id>)
    ; box2text-string(|120)
    
  pp-partial-F-string(|sort) =
    parenthesize-F
    ; prettyprint-F(|sort)
    ; !V([], <id>)
    ; box2text-string(|120)  
      
  pp-debug :
    ast -> result
    with
       result := <pp-F-string> ast
    <+ <bottomup(try(not(is-string); not(is-list); not(pp-F-string); debug(!"cannot pp ")))> ast
    ;  result := ""

rules
  
  construct-textual-change = construct-textual-change(pp-partial-F-string, parenthesize, override-reconstruction, resugar)
