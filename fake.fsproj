<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
    </PropertyGroup>

    <!-- <PropertyGroup>
        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>true</SelfContained>
        <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
        <PublishReadyToRun>true</PublishReadyToRun>
        <PublishTrimmed>true</PublishTrimmed>
        <SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
    </PropertyGroup> -->
    <!-- <ItemGroup>
        <EmbeddedResource Include="lib/fake.ini" />
        <ProjectReference Include="compiler/compiler.fsproj" />
    </ItemGroup> -->

    <PropertyGroup>
        <PackageId>fakeLanguage</PackageId>
        <Version>0.0.1</Version>
        <Authors>Dmitry Ponyatov</Authors>
        <Company>Horizon LLC</Company>
    </PropertyGroup>

    <!-- <ItemGroup>
        <Compile Include="meta/AST.fs" />
        <Compile Include="lib/hello.fs" />
        <Compile Include="meta/cross.fs" />
        <Compile Include="meta/fileTreeLib.fs" />
        <Compile Include="meta/fileTree.fs" />
    </ItemGroup> -->

    <PropertyGroup>
        <FsLexToolExe>fslex.dll</FsLexToolExe>
        <FsYaccToolExe>fsyacc.dll</FsYaccToolExe>
        <FsLexOutputFolder>$(IntermediateOutputPath)tmp/</FsLexOutputFolder>
        <FsYaccOutputFolder>$(IntermediateOutputPath)tmp/</FsYaccOutputFolder>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FsLexYacc" Version="11.3.0" />
        <FsLex Include="meta/Lexer.fsl">
            <OtherFlags>--module Lexer --unicode</OtherFlags>
        </FsLex>
        <FsYacc Include="meta/Parser.fsy">
            <OtherFlags>--module Parser</OtherFlags>
        </FsYacc>
        <Compile Include="tmp/Parser.fsi" />
        <Compile Include="tmp/Parser.fs" />
        <Compile Include="tmp/Lexer.fs" />
    </ItemGroup>

</Project>
