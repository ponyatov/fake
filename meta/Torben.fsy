%{
    open Torben.AST
%}

%token <int>    INT
%token          ADD SUB MUL DIV
%token          EOF

%start syntax
%type <Torben.AST.AST>  syntax
%type <Torben.AST.Expr> expr

%%
syntax:             {      [  ] }
      | syntax expr { $1 @ [$2] }

expr  : ADD expr    { Pfx     ( Add , $2 ) }
      | SUB expr    { Pfx     ( Sub , $2 ) }
      | INT         { Literal ( Int   $1 ) }
