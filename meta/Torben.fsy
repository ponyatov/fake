%{
    open Torben.AST
%}

%token <int>    INT
%token          ADD SUB MUL DIV
%token          EOF

%start syntax
%type <Torben.AST.AST>  syntax
%type <Torben.AST.Expr> expr

%%
syntax:             {      [  ] }
      | syntax expr { $1 @ [$2] }

expr  : INT             { Literal ( Int $1 ) }
      | ADD expr        { Plus  $2 }
      | SUB expr        { Minus $2 }
      | expr ADD expr   { Add ( $1 , $3 ) }
      | expr SUB expr   { Sub ( $1 , $3 ) }
      | expr MUL expr   { Mul ( $1 , $3 ) }
      | expr DIV expr   { Div ( $1 , $3 ) }
